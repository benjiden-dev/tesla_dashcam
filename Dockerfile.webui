# Tesla Dashcam Web UI — single always-on container.
#
# Multi-stage: the React SPA is built in a node stage, then served by the
# FastAPI backend next to the engine and a VAAPI-capable ffmpeg.
#
#   docker compose -f docker-compose.webui.yml up -d --build

# ── Stage 1: frontend build ──────────────────────────────────────────────
FROM node:22-slim AS frontend
WORKDIR /app/webui/frontend
COPY webui/frontend/package.json webui/frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY webui/frontend/ ./
# vite outDir is ../static/dist -> /app/webui/static/dist
RUN npm run build

# ── Stage 2: runtime ─────────────────────────────────────────────────────
FROM python:3.13-slim

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
    # FFmpeg with VAAPI support + drivers (AMD via mesa, Intel via i965/iHD)
    ffmpeg \
    libva2 \
    libva-drm2 \
    mesa-va-drivers \
    intel-media-va-driver \
    i965-va-driver \
    vainfo \
    # Timestamp overlay font used by the engine's Linux default
    fonts-freefont-ttf \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Engine dependencies + web UI dependencies
COPY requirements.txt ./requirements.txt
COPY webui/requirements.txt ./webui/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r webui/requirements.txt

# Engine (run from source; keeps the fork's patches) + backend
COPY tesla_dashcam/ ./tesla_dashcam/
COPY webui/*.py ./webui/
COPY --from=frontend /app/webui/static/dist ./webui/static/dist

ENV PYTHONUNBUFFERED=true \
    TZ=America/Denver \
    INPUT_DIR=/data \
    OUTPUT_DIR=/output \
    CACHE_DIR=/cache \
    ENGINE_CMD="python -m tesla_dashcam" \
    ENGINE_CWD=/app

EXPOSE 8088

RUN useradd -U -u 1000 appuser && chown -R 1000:1000 /app
USER 1000

CMD ["python", "-m", "uvicorn", "webui.app:app", "--host", "0.0.0.0", "--port", "8088"]
